# Copy to .env and fill in. NEVER commit the real .env.
OPENAI_API_KEY=your-key-here
# Optional overrides:
OPENAI_MODEL=gpt-4o
# Region-locked keys need a specific endpoint (e.g. https://us.api.openai.com/v1):
OPENAI_BASE_URL=
# Force deterministic offline mode even if a key is present:
DEAL_DNA_OFFLINE=0
